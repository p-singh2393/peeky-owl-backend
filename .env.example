# ── Database ──────────────────────────────────────────────────────────────────
# Get this from MongoDB Atlas → Connect → Drivers → copy the connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/peeky-owl?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-with-64-char-random-hex-string
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
# Hosting platforms (Railway, Render, EC2) — set PORT automatically or use 5050
PORT=5050
NODE_ENV=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (must match exactly, no trailing slash)
CLIENT_URL=https://peekyowl.com,https://www.peekyowl.com

# ── Payments ──────────────────────────────────────────────────────────────────
# Razorpay live keys from dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
